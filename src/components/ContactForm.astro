---
/**
 * Formulário de contato — renderizado SOMENTE quando PUBLIC_FORM_ENABLED=true
 * e a chave do Turnstile estiver configurada (ver src/lib/config.ts).
 * Não tem campo livre de queixa: o site não coleta informações de saúde.
 */
import Icone from './Icone.astro';
import { AREAS, PARA_QUEM, PERIODOS } from '@/lib/formulario';
import { config } from '@/lib/config';
import { whatsappLink } from '@/lib/whatsapp';
---

<form
  class="formulario"
  action="/api/contato"
  method="post"
  novalidate
  data-formulario
  data-whatsapp={whatsappLink()}
  aria-describedby="form-aviso"
>
  <div class="form-resumo" data-resumo tabindex="-1" role="alert" hidden>
    <p>
      <strong>Confira os campos abaixo:</strong>
    </p>
    <ul data-resumo-lista></ul>
  </div>

  <p id="form-aviso" class="form-aviso">
    <Icone nome="escudo" />
    <span>
      Não descreva sintomas ou informações de saúde. Elas serão tratadas na consulta, com sigilo
      profissional.
    </span>
  </p>

  <p class="pequeno form-obrigatorios">Campos marcados com * são obrigatórios.</p>

  <div class="form-grade">
    <div class="campo">
      <label for="f-nome">Nome *</label>
      <input
        id="f-nome"
        name="nome"
        type="text"
        autocomplete="name"
        required
        maxlength="120"
        aria-describedby="e-nome"
      />
      <p class="campo-erro" id="e-nome" data-erro="nome"></p>
    </div>

    <div class="campo">
      <label for="f-telefone">Telefone ou WhatsApp *</label>
      <input
        id="f-telefone"
        name="telefone"
        type="tel"
        inputmode="tel"
        autocomplete="tel-national"
        placeholder="(27) 99999-9999"
        required
        maxlength="16"
        aria-describedby="e-telefone"
        data-mascara-telefone
      />
      <p class="campo-erro" id="e-telefone" data-erro="telefone"></p>
    </div>

    <div class="campo">
      <label for="f-email">
        E-mail <span class="opcional">(opcional)</span>
      </label>
      <input
        id="f-email"
        name="email"
        type="email"
        autocomplete="email"
        maxlength="160"
        aria-describedby="e-email"
      />
      <p class="campo-erro" id="e-email" data-erro="email"></p>
    </div>

    <div class="campo">
      <label for="f-area">Área de interesse *</label>
      <select id="f-area" name="area" required aria-describedby="e-area">
        <option value="">Selecione</option>
        {AREAS.map((a) => (
          <option value={a}>{a}</option>
        ))}
      </select>
      <p class="campo-erro" id="e-area" data-erro="area"></p>
    </div>

    <fieldset class="campo campo-largo" aria-describedby="e-paraQuem">
      <legend>Para quem é o atendimento? *</legend>
      <div class="opcoes">
        {PARA_QUEM.map((op, i) => (
          <label class="opcao">
            <input type="radio" name="paraQuem" value={op} required={i === 0} />
            <span>{op}</span>
          </label>
        ))}
      </div>
      <p class="campo-erro" id="e-paraQuem" data-erro="paraQuem"></p>
    </fieldset>

    <fieldset class="campo campo-largo" aria-describedby="e-periodo">
      <legend>Melhor período para contato *</legend>
      <div class="opcoes">
        {PERIODOS.map((op, i) => (
          <label class="opcao">
            <input type="radio" name="periodo" value={op} required={i === 0} />
            <span>{op}</span>
          </label>
        ))}
      </div>
      <p class="campo-erro" id="e-periodo" data-erro="periodo"></p>
    </fieldset>
  </div>

  <!-- Armadilha para robôs: invisível para pessoas e leitores de tela -->
  <div class="pote" aria-hidden="true">
    <label for="f-site">Não preencha este campo</label>
    <input id="f-site" name="site" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="inicio" value="" data-inicio />

  <div class="campo campo-largo">
    <label class="consentimento">
      <input type="checkbox" name="consentimento" required aria-describedby="e-consentimento" />
      <span>
        Concordo com o uso dos meus dados para que a equipe retorne o contato, conforme a
        <a href="/politica-de-privacidade" target="_blank">
          Política de Privacidade
        </a>
        . *
      </span>
    </label>
    <p class="campo-erro" id="e-consentimento" data-erro="consentimento"></p>
  </div>

  <div
    class="cf-turnstile"
    data-sitekey={config.turnstileSiteKey}
    data-language="pt-br"
    data-theme="light"
  ></div>

  <button type="submit" class="botao botao-primario form-enviar" data-enviar>
    <span data-enviar-texto>Enviar</span>
  </button>

  <div class="form-retorno" data-retorno role="status" aria-live="polite" tabindex="-1"></div>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  import '@/scripts/formulario';
</script>

<style>
  .formulario {
    display: grid;
    gap: 1.25rem;
  }

  .form-aviso {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--raio);
    background: var(--nevoa);
    font-weight: 600;
    color: var(--noturno);
  }

  .form-aviso :global(.icone) {
    flex: none;
    color: var(--petroleo);
  }

  .form-grade {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .form-grade {
      grid-template-columns: 1fr 1fr;
    }

    .campo-largo {
      grid-column: 1 / -1;
    }
  }

  .campo {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
    border: 0;
    padding: 0;
  }

  label,
  legend {
    font-weight: 700;
    color: var(--noturno);
  }

  legend {
    margin-bottom: 0.5rem;
    padding: 0;
  }

  .opcional {
    font-weight: 500;
    color: var(--ardosia);
  }

  input[type='text'],
  input[type='tel'],
  input[type='email'],
  select {
    width: 100%;
    min-height: 52px;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--ardosia);
    border-radius: var(--raio-s);
    background: var(--branco);
    font-size: 1rem;
  }

  input::placeholder {
    color: var(--ardosia);
    opacity: 1;
  }

  input:focus-visible,
  select:focus-visible {
    outline: 3px solid var(--petroleo);
    outline-offset: 1px;
    border-color: var(--petroleo);
  }

  [aria-invalid='true'] {
    border-color: #a8432a !important;
  }

  .opcoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .opcao,
  .consentimento {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    min-height: 44px;
    padding-block: 0.5rem;
    font-weight: 500;
    color: var(--grafite);
    cursor: pointer;
  }

  .opcao input,
  .consentimento input {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 0.1rem;
    accent-color: var(--petroleo);
  }

  .campo-erro {
    min-height: 0;
    font-weight: 700;
    font-size: var(--fs-pequeno);
    color: #a8432a;
  }

  .campo-erro:empty {
    display: none;
  }

  .pote {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-resumo {
    padding: 1.25rem 1.5rem;
    border: 2px solid #a8432a;
    border-radius: var(--raio);
    background: var(--branco);
  }

  .form-resumo ul {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
  }

  .form-enviar {
    justify-self: start;
    min-width: 180px;
  }

  .form-enviar[aria-busy='true'] {
    opacity: 0.8;
    cursor: progress;
  }

  .form-retorno:empty {
    display: none;
  }

  .form-retorno {
    padding: 1.25rem 1.5rem;
    border-radius: var(--raio);
    background: var(--bruma);
    font-weight: 600;
    color: var(--noturno);
  }

  .form-retorno :global(a) {
    font-weight: 700;
  }
</style>
