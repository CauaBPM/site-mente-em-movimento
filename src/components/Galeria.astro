---
/** Galeria de fotos reais e autorizadas. Não renderiza nada se a lista estiver vazia. */
import { Picture } from 'astro:assets';
import { fotosPublicadas } from '@/content/fotos';
---

{fotosPublicadas.length > 0 && (
  <ul class="galeria">
    {fotosPublicadas.map((foto) => (
      <li>
        <Picture
          src={foto.arquivo}
          alt={foto.alt}
          widths={[400, 800, 1200]}
          sizes="(min-width: 900px) 33vw, 100vw"
          formats={['avif', 'webp']}
          loading="lazy"
          decoding="async"
        />
      </li>
    ))}
  </ul>
)}

<style>
  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
  }

  .galeria :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--raio);
  }
</style>
