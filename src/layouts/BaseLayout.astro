---
import '@/styles/tokens.css';
import '@/styles/base.css';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFab from '@/components/WhatsAppFab.astro';
import { config } from '@/lib/config';

interface Props {
  titulo: string;
  descricao: string;
  caminho?: string;
  dados?: object[];
  noindex?: boolean;
  /** Mensagem do botão flutuante do WhatsApp (por especialidade, por exemplo) */
  mensagemWhatsApp?: string;
}

const { titulo, descricao, caminho, dados, noindex, mensagemWhatsApp } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <Seo titulo={titulo} descricao={descricao} caminho={caminho} dados={dados} noindex={noindex} />
    <meta name="theme-color" content="#EEEFF1" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {config.analytics === 'plausible' && config.plausibleDominio && (
      <script
        is:inline
        defer
        data-domain={config.plausibleDominio}
        src="https://plausible.io/js/script.tagged-events.js"
      />
    )}
    {config.analytics === 'umami' && config.umamiSrc && config.umamiId && (
      <script is:inline defer src={config.umamiSrc} data-website-id={config.umamiId} />
    )}
    {config.analytics === 'cloudflare' && config.cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: config.cfBeaconToken })}
      />
    )}
  </head>
  <body>
    <a class="pular-conteudo" href="#conteudo">
      Pular para o conteúdo
    </a>
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab mensagem={mensagemWhatsApp} />
    <script>
      import '@/scripts/global';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
