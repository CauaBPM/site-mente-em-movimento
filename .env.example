# Copie para .env e preencha. NUNCA versione o arquivo .env.

# Domínio canônico (sem barra no final). Pendente de confirmação com a clínica.
SITE_URL=https://menteemmovimentovv.com.br

# ---------------------------------------------------------------
# Formulário de contato — fica DESATIVADO até a clínica confirmar
# um e-mail de destino. Para ativar, use "true" e preencha tudo abaixo.
# ---------------------------------------------------------------
PUBLIC_FORM_ENABLED=false
# Chave pública do Cloudflare Turnstile (aparece no HTML)
PUBLIC_TURNSTILE_SITE_KEY=

# Variáveis abaixo são SECRETAS: configure-as no painel da hospedagem
# (Cloudflare Pages → Settings → Variables and Secrets), não no código.
# E-mail que recebe os contatos (o único conhecido, do cadastro da Receita,
# ainda não foi confirmado como canal público e não é exibido no site).
CONTACT_EMAIL=
# Remetente verificado no provedor de e-mail transacional
CONTACT_FROM=
# Chave da API do Resend (https://resend.com)
RESEND_API_KEY=
# Chave secreta do Cloudflare Turnstile
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------
# Análise de tráfego sem cookies (opcional). Valores: plausible | umami | cloudflare
# Deixe vazio para não carregar nenhum script de análise.
# ---------------------------------------------------------------
PUBLIC_ANALYTICS=
# Plausible: domínio cadastrado no Plausible
PUBLIC_PLAUSIBLE_DOMAIN=
# Umami: ID do site e URL do script (ex.: https://cloud.umami.is/script.js)
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=
# Cloudflare Web Analytics: token do beacon (não registra eventos personalizados)
PUBLIC_CF_BEACON_TOKEN=

# Verificação do Google Search Console por meta tag (prefira verificação por DNS)
PUBLIC_GOOGLE_SITE_VERIFICATION=
