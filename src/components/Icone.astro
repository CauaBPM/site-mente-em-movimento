  // —— complementares, no mesmo estilo ——
  relogio: '<circle cx="24" cy="24" r="16"/><path d="M24 15v9l6 4"/>',
  telefone:
    '<path d="M17.5 8.5 13 9c-2.5.3-4.3 2.6-4 5.1C10.4 27.6 20.4 37.6 33.9 39c2.5.3 4.8-1.5 5.1-4l.5-4.5a2 2 0 0 0-1.4-2.1l-6-1.9a2 2 0 0 0-2.1.6l-2.4 2.8a22 22 0 0 1-9.5-9.5l2.8-2.4a2 2 0 0 0 .6-2.1l-1.9-6a2 2 0 0 0-2.1-1.4z"/>',
  seta: '<path d="M10 24h28M28 14l10 10-10 10"/>',
  externo:
    '<path d="M27 9h12v12M39 9 22 26"/><path d="M34 29v8a2 2 0 0 1-2 2H11a2 2 0 0 1-2-2V16a2 2 0 0 1 2-2h8"/>',
  instagram:
    '<rect x="8" y="8" width="32" height="32" rx="9"/><circle cx="24" cy="24" r="7.5"/><circle cx="33.5" cy="14.5" r="1.8" fill="currentColor" stroke="none"/>',
  menu: '<path d="M8 15h32M8 24h32M8 33h32"/>',
  fechar: '<path d="M12 12l24 24M36 12 12 36"/>',
  mais: '<path d="M24 12v24M12 24h24"/>',
  verificado: '<circle cx="24" cy="24" r="16"/><path d="m17 24.5 5 5 9-10"/>',
