---
import { clinica } from '@/content/clinica';
import { config } from '@/lib/config';

interface Props {
  titulo: string;
  descricao: string;
  /** Caminho canônico (ex.: "/contato"). Padrão: URL atual. */
  caminho?: string;
  imagem?: string;
  /** Objetos JSON-LD */
  dados?: object[];
  noindex?: boolean;
}

const {
  titulo,
  descricao,
  caminho,
  imagem = '/og-image.png',
  dados = [],
  noindex = false,
} = Astro.props;

const site = Astro.site!;
let atual = (caminho ?? Astro.url.pathname).replace(/\.html$/, '').replace(/\/index$/, '/');
if (atual.length > 1) atual = atual.replace(/\/$/, '');
const canonica = new URL(atual, site).href;
const imagemAbs = new URL(imagem, site).href;
---

<title>{titulo}</title>
<meta name="description" content={descricao} />
<link rel="canonical" href={canonica} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={clinica.nomeComCidade} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descricao} />
<meta property="og:url" content={canonica} />
<meta property="og:image" content={imagemAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Logo da Mente em Movimento – Centro de Saúde Mental e Cognitiva, em Vila Velha – ES"
/>

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descricao} />
<meta name="twitter:image" content={imagemAbs} />

<meta name="geo.region" content="BR-ES" />
<meta name="geo.placename" content="Vila Velha" />
<meta name="geo.position" content={`${clinica.geo.latitude};${clinica.geo.longitude}`} />

{config.googleVerificacao && (
  <meta name="google-site-verification" content={config.googleVerificacao} />
)}

{dados.map((d) => (
  <script type="application/ld+json" set:html={JSON.stringify(d)} />
))}
