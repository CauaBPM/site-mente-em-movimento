---
/** Rede cognitiva — diagrama de nós para conteúdos de neuropsicologia. Decorativo. */
interface Props {
  class?: string;
}
const { class: classe } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="90 30 720 330"
  class:list={['rede-cognitiva', classe]}
  aria-hidden="true"
  focusable="false"
>
  <g stroke="#1F6078" stroke-width="2" fill="none" opacity=".55">
    <path d="M120 110 L330 60 L560 130 L780 80"></path>
    <path d="M330 60 L300 270 L560 130 L620 330"></path>
    <path d="M120 110 L300 270 L620 330 L780 80"></path>
  </g>
  <g fill="#249C90">
    <circle cx="120" cy="110" r="12"></circle>
    <circle cx="560" cy="130" r="12"></circle>
    <circle cx="620" cy="330" r="12"></circle>
  </g>
  <g fill="#FFFFFF" stroke="#1F6078" stroke-width="3">
    <circle cx="330" cy="60" r="14"></circle>
    <circle cx="300" cy="270" r="14"></circle>
    <circle cx="780" cy="80" r="14"></circle>
  </g>
</svg>
