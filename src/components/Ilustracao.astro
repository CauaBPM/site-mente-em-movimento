---
/**
 * Imagem ilustrativa de atendimento (banco de imagens), com legenda discreta
 * "Imagem ilustrativa" para não ser confundida com registro real da clínica.
 */
import { Picture } from 'astro:assets';
import type { Ilustracao } from '@/content/ilustracoes';

interface Props {
  ilustracao: Ilustracao;
  /** Atributo `sizes` conforme a largura ocupada no layout. */
  sizes?: string;
  /** Proporção do recorte (CSS aspect-ratio). */
  proporcao?: string;
  /** Imagem na primeira área visível: carrega sem atraso. */
  prioridade?: boolean;
  class?: string;
}

const {
  ilustracao,
  sizes = '(min-width: 1024px) 50vw, 100vw',
  proporcao = '4 / 3',
  prioridade = false,
  class: classe,
} = Astro.props;
---

<figure class:list={['ilustracao', classe]} style={`--proporcao: ${proporcao}`}>
  <Picture
    src={ilustracao.arquivo}
    alt={ilustracao.alt}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading={prioridade ? 'eager' : 'lazy'}
    decoding="async"
  />
  <figcaption>Imagem ilustrativa</figcaption>
</figure>

<style>
  .ilustracao {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--raio-l);
    background: var(--bruma);
  }

  .ilustracao :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: var(--proporcao);
    object-fit: cover;
  }

  figcaption {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: rgb(19 48 74 / 0.72);
    color: var(--branco);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
  }
</style>
