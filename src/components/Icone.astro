  whatsapp:
    '<path fill="currentColor" stroke="none" d="M24 5.5C13.8 5.5 5.6 13.7 5.6 23.8c0 3.3.9 6.5 2.5 9.3L5.5 42.5l9.7-2.5a18.3 18.3 0 0 0 8.8 2.2h0c10.1 0 18.4-8.2 18.4-18.4 0-4.9-1.9-9.5-5.4-13A18.3 18.3 0 0 0 24 5.5zm0 33.6c-2.7 0-5.4-.7-7.8-2.1l-.6-.3-5.8 1.5 1.5-5.6-.4-.6a15.2 15.2 0 0 1-2.3-8.1C8.7 15.5 15.6 8.6 24 8.6c4.1 0 7.9 1.6 10.8 4.5a15.2 15.2 0 0 1 4.5 10.8c0 8.4-6.9 15.2-15.3 15.2zm8.4-11.4c-.5-.2-2.7-1.3-3.1-1.5-.4-.2-.7-.2-1 .2-.3.5-1.2 1.5-1.4 1.8-.3.3-.5.3-1 .1-.5-.2-1.9-.7-3.6-2.3-1.3-1.2-2.2-2.6-2.5-3.1-.3-.5 0-.7.2-.9l.7-.8c.2-.3.3-.5.5-.8.2-.3.1-.6 0-.8-.1-.2-1-2.4-1.4-3.3-.4-.9-.7-.7-1-.8h-.9c-.3 0-.8.1-1.2.6-.4.5-1.6 1.6-1.6 3.8s1.6 4.4 1.9 4.7c.2.3 3.2 4.9 7.7 6.8 1.1.5 1.9.8 2.6 1 1.1.3 2.1.3 2.9.2.9-.1 2.7-1.1 3.1-2.2.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5z"/>',
} as const;

const { nome, tamanho = 24, rotulo, class: classe } = Astro.props;
const conteudo = icones[nome];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  width={tamanho}
  height={tamanho}
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icone', classe]}
  aria-hidden={rotulo ? undefined : 'true'}
  role={rotulo ? 'img' : undefined}
  aria-label={rotulo}
  focusable="false"
  set:html={conteudo}
/>
